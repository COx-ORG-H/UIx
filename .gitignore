# caches / OS (the global gitignore also covers these)
node_modules/
.DS_Store
Thumbs.db
*.log

# package build output: regenerated on `build`/publish, never committed (unlike build/ below)
packages/*/dist/

# build/ is generated but COMMITTED on purpose: the showcase opens build-free and index.html
# imports build/css/tokens.css through styles/. Override the global gitignore that excludes build/.
!build/
!build/**
# ...except the two minified bundles. Each is ONE line, so any two PRs that touch component CSS
# conflict on it by construction (2026-10-07: ten open PRs went DIRTY on one merge). CI, the docs
# site and publishing all build them, and without a build the docs load styles/main.css instead.
packages/tokens/build/css/styles.css
packages/tokens/build/css/components.css

# Playwright VR (S5): run outputs are transient; only the Linux goldens are tracked.
test-results/
playwright-report/
blob-report/
playwright/.cache/
# local Windows/macOS runs produce these — they never match the Linux CI runner, so never commit them
tests/visual/__screenshots__/*-win32.png
tests/visual/__screenshots__/*-darwin.png

# Playwright MCP verification artifacts (screenshots/snapshots/console logs)
.playwright-mcp/

# Playwright harness bundles: tests/<name>/build.mjs writes tests/<name>/dist/. One pattern for all
# of them: a line per harness was a line every harness PR appended here, so they conflicted.
tests/*/dist/
