# caches / OS (the global gitignore also covers these)
node_modules/
.DS_Store
Thumbs.db
*.log

# package build output: regenerated on `build`/publish, never committed (unlike build/ below)
packages/*/dist/

# build/ is generated but COMMITTED on purpose: the showcase opens build-free and index.html
# imports build/css/tokens.css through styles/. Override the global gitignore that excludes build/.
!build/
!build/**

# Playwright VR (S5): run outputs are transient; only the Linux goldens are tracked.
test-results/
playwright-report/
blob-report/
playwright/.cache/
# local Windows/macOS runs produce these — they never match the Linux CI runner, so never commit them
tests/visual/__screenshots__/*-win32.png
tests/visual/__screenshots__/*-darwin.png

# Playwright MCP verification artifacts (screenshots/snapshots/console logs)
.playwright-mcp/

# rich-text Playwright harness bundle (tests/rich-text/build.mjs)
tests/rich-text/dist/
# operator-primitives Playwright harness bundle (tests/operator-primitives/build.mjs)
tests/operator-primitives/dist/
# DiffViewer Playwright harness bundle (tests/diff-viewer/build.mjs)
tests/diff-viewer/dist/
# ViewMenu Playwright harness bundle (tests/view-menu/build.mjs)
tests/view-menu/dist/
# InfoTip Playwright harness bundle (tests/info-tip/build.mjs)
tests/info-tip/dist/
tests/search-suggest/dist/
# Drawer/Peek Playwright harness bundle (tests/drawer/build.mjs)
tests/drawer/dist/
