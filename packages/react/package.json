    "@tiptap/suggestion": "3.31.3",
    "@types/react": "^18.0.0",
    "@types/react-dom": "^18.0.0",
    "echarts": "^5.6.0",
    "emojibase-data": "17.0.0",
    "esbuild": "^0.27.0",
    "jsdom": "30.1.0",
    "marked": "17.0.6",
