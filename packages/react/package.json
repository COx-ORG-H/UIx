    },
    "@tiptap/pm": {
      "optional": true
    },
    "@tiptap/react": {
      "optional": true
    },
    "@tiptap/starter-kit": {
      "optional": true
    },
    "@tiptap/suggestion": {
      "optional": true
    },
    "echarts": {
      "optional": true
    },
    "emojibase-data": {
      "optional": true
    },
    "marked": {
