{
  "bg-app":    { "$type": "color", "$value": "#0A0A0A" },
  "bg-subtle": { "$type": "color", "$value": "#171717" },
  "bg-hover":  { "$type": "color", "$value": "#1F1F1F" },
  "bg-active": { "$type": "color", "$value": "#262626" },
  "surface":   { "$type": "color", "$value": "#111111" },
  "surface-2": { "$type": "color", "$value": "#171717" },
  "surface-3": { "$type": "color", "$value": "#262626" },
  "border":        { "$type": "color", "$value": "rgba(255,255,255,.08)" },
  "border-strong": { "$type": "color", "$value": "rgba(255,255,255,.14)" },

  "text":        { "$type": "color", "$value": "#FAFAFA" },
  "text-hushed": { "$type": "color", "$value": "rgba(250,250,250,.64)" },
  "text-muted":  { "$type": "color", "$value": "#A1A1A1" },

  "accent":       { "$type": "color", "$value": "var(--uix-brand,#2563EB)" },
  "accent-hover": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-accent) 94%, #FFFFFF)", "$description": "On dark, primary-button hover LIGHTENS the accent (the light-theme value darkens). Tracks the live brand override." },
  "link":         { "$type": "color", "$value": "color-mix(in srgb, var(--uix-brand,#5B8DEF) 70%, #FFFFFF)", "$description": "Brightened on dark so links read clearly as links and stay distinct from the solid accent button background." },
  "accent-text":  { "$type": "color", "$value": "color-mix(in srgb, var(--uix-accent) 70%, #FFFFFF)", "$description": "On dark, accent-hued text LIGHTENS the accent (the light-theme value darkens): the solid dark accent measured 3.2:1 on its own 16% tint. Same 70% weight as --uix-link." },
  "ring":         { "$type": "color", "$value": "var(--uix-brand,#3080FF)" },
  "brand-muted": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-accent) 16%, transparent)" },

  "success":    { "$type": "color", "$value": "#5DB887", "$description": "Calibrated (HAR-1562, calm kit 2.56): dark status TEXT tokens share one lightness band (OKLCH L 74-80%, C <= 0.10) near --uix-text-hushed, SOLIDS C <= 0.14, tints = solid at 12% alpha. Dark --uix-success is the fill/dot (dark --uix-success-fg on it, 6.3:1); text is --uix-success-text." },
  "success-fg": { "$type": "color", "$value": "#002C22" },
  "success-bg": { "$type": "color", "$value": "rgba(93,184,135,.12)" },
  "success-text": { "$type": "color", "$value": "#7CC79F", "$description": "Success-toned TEXT on dark: 9.5:1 on --uix-surface, 8.0:1 on its own tint." },
  "warning":      { "$type": "color", "$value": "#D9B571", "$description": "On dark --uix-warning carries the calibrated warning TEXT value, because --uix-warning-text chains to it (var(--uix-warning,...)) and that chain is part of the contract. The fill/dot role is --uix-warning-solid. Calm kit (2.56): C 0.096." },
  "warning-fg":   { "$type": "color", "$value": "#1A1A1A" },
  "warning-bg":   { "$type": "color", "$value": "rgba(217,168,74,.12)" },
  "warning-border": { "$type": "color", "$value": "#B48C3E", "$description": "On dark, a deeper amber than the warning text so the outline reads as a tone rather than a highlight; 6.1:1 on --uix-surface #111111 (calm kit 2.56, was #CA8A04)." },
  "warning-text": { "$type": "color", "$value": "var(--uix-warning,#D9B571)", "$description": "On dark, warning text tracks --uix-warning live (fallback to the dark warning value: 9.7:1 on --uix-surface, 8.0:1 on its own tint)." },
  "info":       { "$type": "color", "$value": "#3D5CC8", "$description": "The dark info FILL with white --uix-info-fg on it: 5.9:1 (calm kit 2.56, was #2563EB, C 0.2). Text is --uix-info-text." },
  "info-fg":    { "$type": "color", "$value": "#FFFFFF" },
  "info-bg":    { "$type": "color", "$value": "rgba(120,144,230,.12)" },
  "info-text":  { "$type": "color", "$value": "#97AEEC", "$description": "On dark, info TEXT in the calibrated band: 8.6:1 on --uix-surface, 7.4:1 on its own tint (calm kit 2.56)." },
  "danger":     { "$type": "color", "$value": "#B4444A", "$description": "The dark danger FILL (destructive button, solid critical pill) with white --uix-danger-fg on it: 5.4:1. Calm kit (2.56): C 0.146, was #BE3A41." },
  "danger-fg":  { "$type": "color", "$value": "#FFFFFF" },
  "danger-bg":  { "$type": "color", "$value": "rgba(218,108,100,.12)" },
  "danger-border": { "$type": "color", "$value": "#DA6C64", "$description": "On dark, the danger dot as an outline; 5.7:1 on --uix-surface #111111." },
  "danger-text": { "$type": "color", "$value": "#E4958F", "$description": "On dark, danger-toned TEXT for pill/field-error/stat-trend/menu/node/audit and StatusDot critical. Calibrated band (L 74.8 %, C 0.096): 8.1:1 on --uix-surface, 7.1:1 on its own tint. --uix-danger stays the fill (with white --uix-danger-fg)." },
  "amber":      { "$type": "color", "$value": "#E6B25C", "$description": "SEV-3 tone lightened for dark surfaces (the light-mode ochre #C98A1E is too dark on dark)." },
  "amber-text": { "$type": "color", "$value": "#DDB370", "$description": "On dark, amber TEXT in the calibrated status-text band (HAR-1562: C <= 0.10; the old #E6B25C was C 0.12)." },
  "amber-bg":   { "$type": "color", "$value": "rgba(201,138,30,.14)" },

  "attention":       { "$type": "color", "$value": "#DD854C", "$description": "Dark attention solid (HAR-1562 calibration; the light-mode #EA580C is too dark on dark)." },
  "attention-bg":    { "$type": "color", "$value": "rgba(221,133,76,.12)" },
  "attention-text":  { "$type": "color", "$value": "#DFA779", "$description": "On dark, attention TEXT: 8.9:1 on --uix-surface, reads AA on the faint attention-bg." },
  "attention-solid": { "$type": "color", "$value": "#DD854C" },

  "overdue":       { "$type": "color", "$value": "#DA6C6C", "$description": "Dark overdue solid (HAR-1562 calibration; the light-mode #DC2626 fails on dark)." },
  "overdue-bg":    { "$type": "color", "$value": "rgba(218,108,108,.12)" },
  "overdue-text":  { "$type": "color", "$value": "#E89D9F", "$description": "On dark, overdue TEXT: 8.8:1 on --uix-surface, reads AA on the faint overdue-bg." },
  "overdue-solid": { "$type": "color", "$value": "#DA6C6C" },

  "success-solid": { "$type": "color", "$value": "#5DB887" },
  "warning-solid": { "$type": "color", "$value": "#D9A84A" },
  "info-solid":    { "$type": "color", "$value": "#7890E6" },
  "danger-solid":  { "$type": "color", "$value": "#DA6C64" },
  "neutral-solid": { "$type": "color", "$value": "#868686", "$description": "Dark neutral status solid (dot/fill): 5.2:1 on --uix-surface." },

  "chart-1": { "$type": "color", "$value": "#3280FC", "$description": "Categorical palette v2, dark (calm kit 2.56): the same order as light (series blue, teal, violet, then green, plum, olive, cyan, moss), stepped for the dark band (L 0.48-0.67); chart-1 stays the dark brand blue #3280FC, and chart-3/chart-7 are stepped off it so it stands apart from every slot; validated against --uix-surface #111111 and --uix-bg-app." },
  "chart-2": { "$type": "color", "$value": "#22A093" },
  "chart-3": { "$type": "color", "$value": "#A580CF" },
  "chart-4": { "$type": "color", "$value": "#4E9F62" },
  "chart-5": { "$type": "color", "$value": "#C474AC" },
  "chart-6": { "$type": "color", "$value": "#93993A" },
  "chart-7": { "$type": "color", "$value": "#0A819D" },
  "chart-8": { "$type": "color", "$value": "#6E9147" },
  "chart-series-soft": { "$type": "color", "$value": "rgba(50,128,252,.18)" },
  "chart-neutral": { "$type": "color", "$value": "#A1A1A1" },
  "chart-grid": { "$type": "color", "$value": "#232323" },
  "chart-axis": { "$type": "color", "$value": "#3A3A3A" },
  "chart-reference": { "$type": "color", "$value": "#B3B3B3" },
  "chart-zone-warning": { "$type": "color", "$value": "rgba(217,164,64,.10)" },
  "chart-zone-danger": { "$type": "color", "$value": "rgba(218,108,100,.10)" },
  "chart-forecast-band": { "$type": "color", "$value": "rgba(250,250,250,.06)" },
  "chart-event": { "$type": "color", "$value": "#8C8C8C" },
  "chart-partial": { "$type": "color", "$value": "rgba(250,250,250,.12)" },
  "chart-comparison": { "$type": "color", "$value": "#5C5C5C" },

  "file-img": { "$type": "color", "$value": "#A58FE6" },
  "file-img-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-img) 15%, transparent)" },
  "file-img-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-img) 26%, transparent)" },
  "file-img-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-img) 32%, var(--uix-border))" },
  "file-img-label": { "$type": "color", "$value": "var(--uix-file-img)" },
  "file-doc": { "$type": "color", "$value": "#3786C3" },
  "file-doc-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-doc) 15%, transparent)" },
  "file-doc-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-doc) 26%, transparent)" },
  "file-doc-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-doc) 32%, var(--uix-border))" },
  "file-doc-label": { "$type": "color", "$value": "var(--uix-file-doc)" },
  "file-sheet": { "$type": "color", "$value": "#5DB07A" },
  "file-sheet-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-sheet) 15%, transparent)" },
  "file-sheet-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-sheet) 26%, transparent)" },
  "file-sheet-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-sheet) 32%, var(--uix-border))" },
  "file-sheet-label": { "$type": "color", "$value": "var(--uix-file-sheet)" },
  "file-slides": { "$type": "color", "$value": "#B76B1C" },
  "file-slides-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-slides) 15%, transparent)" },
  "file-slides-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-slides) 26%, transparent)" },
  "file-slides-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-slides) 32%, var(--uix-border))" },
  "file-slides-label": { "$type": "color", "$value": "var(--uix-file-slides)" },
  "file-pdf": { "$type": "color", "$value": "#D04E7F" },
  "file-pdf-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-pdf) 15%, transparent)" },
  "file-pdf-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-pdf) 26%, transparent)" },
  "file-pdf-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-pdf) 32%, var(--uix-border))" },
  "file-pdf-label": { "$type": "color", "$value": "var(--uix-file-pdf)" },
  "file-mail": { "$type": "color", "$value": "#55A9D9" },
  "file-mail-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-mail) 15%, transparent)" },
  "file-mail-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-mail) 26%, transparent)" },
  "file-mail-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-mail) 32%, var(--uix-border))" },
  "file-mail-label": { "$type": "color", "$value": "var(--uix-file-mail)" },
  "file-code": { "$type": "color", "$value": "#3DB5A7" },
  "file-code-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-code) 15%, transparent)" },
  "file-code-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-code) 26%, transparent)" },
  "file-code-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-code) 32%, var(--uix-border))" },
  "file-code-label": { "$type": "color", "$value": "var(--uix-file-code)" },
  "file-log": { "$type": "color", "$value": "#A3AE4C" },
  "file-log-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-log) 15%, transparent)" },
  "file-log-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-log) 26%, transparent)" },
  "file-log-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-log) 32%, var(--uix-border))" },
  "file-log-label": { "$type": "color", "$value": "var(--uix-file-log)" },
  "file-archive": { "$type": "color", "$value": "#B0A08A" },
  "file-archive-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-archive) 15%, transparent)" },
  "file-archive-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-archive) 26%, transparent)" },
  "file-archive-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-archive) 32%, var(--uix-border))" },
  "file-archive-label": { "$type": "color", "$value": "var(--uix-file-archive)" },
  "file-text": { "$type": "color", "$value": "var(--uix-file-other)" },
  "file-text-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-text) 15%, transparent)" },
  "file-text-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-text) 26%, transparent)" },
  "file-text-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-text) 32%, var(--uix-border))" },
  "file-text-label": { "$type": "color", "$value": "var(--uix-file-text)" },
  "file-other": { "$type": "color", "$value": "#8C8C8C" },
  "file-other-soft": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-other) 15%, transparent)" },
  "file-other-strong": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-other) 26%, transparent)" },
  "file-other-edge": { "$type": "color", "$value": "color-mix(in srgb, var(--uix-file-other) 32%, var(--uix-border))" },
  "file-other-label": { "$type": "color", "$value": "var(--uix-file-other)" },
  "file-label-fg": { "$type": "color", "$value": "#0A0A0A" },

  "row":           { "$type": "color", "$value": "#111111" },
  "row-alt":       { "$type": "color", "$value": "#161616" },
  "row-pinned-bg":   { "$type": "color", "$value": "rgba(48,128,255,.08)" },
  "row-selected-bg": { "$type": "color", "$value": "rgba(48,128,255,.16)", "$description": "Dark-mode selection wash — stronger than row-pinned-bg (rgba(48,128,255,.08)) so selected rows read apart from pinned." },

  "scrollbar-thumb":       { "$type": "color", "$value": "rgba(255,255,255,.18)" },
  "scrollbar-thumb-hover": { "$type": "color", "$value": "rgba(255,255,255,.30)" }
}
